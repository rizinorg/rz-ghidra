project(
  'ghidra', 'cpp',
  default_options: [
    'werror=false',
    'warning_level=1',
    'buildtype=debug',
    'c_std=c11',
    'cpp_std=c++11',
    'optimization=g',
    'b_ndebug=if-release',
  ]
)

# FIXME: Create a wrap-environment as fallback!
if get_option('generate_parsers')
  yacc = find_program('yacc', required : true)
  flex = find_program('flex', required : true)
endif

source_base = [
                # 'xml.cc',                                # generated by yacc task
                'marshal.cc',
                'space.cc',
                'float.cc',
                'address.cc',
                'pcoderaw.cc',
                'translate.cc',
                'opcodes.cc',
                'globalcontext.cc',
  ]

source_base_yacc = [
  'xml',
  ]

source_decompiler = [
        'capability.cc',
        'architecture.cc',
        'options.cc',
        'graph.cc',
        'cover.cc',
        'block.cc',
        'cast.cc',
        'expression.cc',
        'typeop.cc',
        'database.cc',
        'cpool.cc',
        'comment.cc',
        'fspec.cc',
        'action.cc',
        'loadimage.cc',
        # 'grammar.cc ',    # doesn't seem to be used
        'varnode.cc',
        'op.cc',
        'type.cc',
        'variable.cc',
        'varmap.cc',
        'jumptable.cc',
        'emulate.cc',
        'emulateutil.cc',
        'flow.cc',
        'userop.cc',
        'funcdata.cc',
        'funcdata_block.cc',
        'funcdata_varnode.cc',
        'unionresolve.cc',
        'funcdata_op.cc',
        'pcodeinject.cc',
        'heritage.cc',
        'prefersplit.cc',
        'rangeutil.cc',
        'ruleaction.cc',
        'subflow.cc',
        'blockaction.cc',
        'merge.cc',
        'double.cc',
        'coreaction.cc',
        'condexe.cc',
        'constseq.cc',
        'override.cc',
        'dynamic.cc',
        'crc32.cc',
        'prettyprint.cc',
        'printlanguage.cc',
        'printc.cc',
        'printjava.cc',
        'memstate.cc',
        'modelrules.cc',
        'multiprecision.cc',
        'opbehavior.cc',
        'paramid.cc',
        'transform.cc',
        'string_ghidra.cc',
        'stringmanage.cc',
        # 'callgraph.cc',                  # uncomment for debug
        # 'ifacedecomp.cc',                # uncomment for debug
        # 'ifaceterm.cc',                  # uncomment for debug
        # 'interface.cc',                  # uncomment for debug
  ]

source_libdecomp = ['libdecomp.cc',]

source_ghidra = [
                'ghidra_process.cc',
                'ghidra_arch.cc',
                'loadimage_ghidra.cc',
                'typegrp_ghidra.cc',
                'database_ghidra.cc',
                'ghidra_context.cc',
                'cpool_ghidra.cc',
                'comment_ghidra.cc',
                'inject_ghidra.cc',
                'ghidra_translate.cc',
  ]

source_sleigh = [
                'sleigh_arch.cc',
                'sleigh.cc',
                'inject_sleigh.cc',
                'filemanage.cc',
                'semantics.cc',
                'slghsymbol.cc',
                'context.cc',
                'sleighbase.cc',
                'slghpatexpress.cc',
                'slghpattern.cc',
                'slaformat.cc',
                'compression.cc',
                'pcodecompile.cc',
  ]

source_sleigh_yacc = [
                'pcodeparse',
                'grammar',
  ]

source_console = [
                'consolemain.cc',
                'interface.cc',
                'ifacedecomp.cc',
                'testfunction.cc',
                'ifaceterm.cc',
                'callgraph.cc',
                'raw_arch.cc',
  ]

source_sleigh_compiler = [
                'slgh_compile.cc',
                'slgh_compile.hh',
                'slaformat.cc',
                'slaformat.hh',
                'compression.cc',
                'compression.hh',
  ]

source_sleigh_compiler_yacc = [
                'slghparse',
  ]

source_sleigh_compiler_flex = [
                'slghscan',
  ]

source_dir = join_paths('Ghidra', 'Features', 'Decompiler', 'src', 'decompile', 'cpp')


ghidra_source_base = []
ghidra_source_decompiler = []
libs_list = {}
exec_list = {}

target_list = {
    'ghidra_base': [source_base, source_base_yacc, [], true, []],
    'ghidra_decompiler': [source_decompiler, [], [], true, ['ghidra_base']],
    'ghidra_sleigh': [source_sleigh, source_sleigh_yacc, [], true, ['ghidra_base']],
    'ghidra_libdecomp': [source_libdecomp, [], [], true, ['ghidra_decompiler', 'ghidra_sleigh']],
    'sleighc': [source_sleigh_compiler, source_sleigh_compiler_yacc,
      source_sleigh_compiler_flex, false, ['ghidra_sleigh']],
  }

if get_option('build-decompile-executable')
  target_list += {
    'decompile': [source_ghidra, [], [], false, ['ghidra_decompiler']],
  }
endif

if get_option('build-decompile-cli-executable')
  target_list += {
    'decompile_cli': [source_console, [], [], false, ['ghidra_libdecomp']],
  }
endif

foreach name,src : target_list
  source_list = []
  foreach p : src[0]
    source_list += [join_paths(source_dir, p)]
  endforeach
  if get_option('generate_parsers')
    yacc_flags = []
    foreach p : src[1]
      source_list += [ custom_target(p,
        input: join_paths(source_dir, '@0@.y'.format(p)),
        output: '@0@.cpp'.format(p),
        command: [yacc, '@INPUT@', '-o', '@OUTPUT@' ] + yacc_flags) ]
    endforeach
    foreach p : src[2]
      source_list += [ custom_target(p,
        input: join_paths(source_dir, '@0@.l'.format(p)),
        output: '@0@.cpp'.format(p),
        command: [flex, '-o', '@OUTPUT@', '@INPUT@' ]) ]
    endforeach
  endif

  lib_deps = []
  lib_deps += [ dependency('zlib', required: true) ] #  FIXME: only required for sleigh_compiler!
  foreach l : src[4]
    lib_deps += declare_dependency(link_with: libs_list[l])
  endforeach

  if src[3]
    libs_list += {
      name : static_library(name, source_list, include_directories: source_dir, pic: true,
        dependencies: lib_deps),
      }
  else
    exec_list += {
      name : executable(name, source_list, include_directories: source_dir, pie: true,
        dependencies: lib_deps),
      }
  endif
endforeach

sla_files = []

if get_option('build-slaspecs')
  sleigh_base = join_paths(meson.current_build_dir(), 'sleigh')
  # Generated with:
  # for p in $(ls -1 ../subprojects/ghidra/Ghidra/Processors/); do cd "$BUILDDIR/../subprojects/ghidra/Ghidra/Processors/$p"; echo -n "      ['$p', [" ; for i in $(find -name "*.slaspec"); do echo -n "'$(basename -s .slaspec $i)', "; done ; echo "]],"  ; done ; cd "$BUILDDIR"
  foreach p : [
      ['6502', ['65c02', '6502', ]],
      ['68000', ['68020', '68030', 'coldfire', '68040', ]],
      ['8048', ['8048', ]],
      ['8051', ['80251', 'mx51', '80390', '8051', ]],
      ['8085', ['8085', ]],
      ['AARCH64', ['AARCH64BE', 'AARCH64_AppleSilicon', 'AARCH64', ]],
      ['ARM', ['ARM8_le', 'ARM4_le', 'ARM5_le', 'ARM7_be', 'ARM4t_be', 'ARM7_le', 'ARM8m_be', 'ARM4_be', 'ARM5t_le', 'ARM5t_be', 'ARM4t_le', 'ARM6_le', 'ARM8m_le', 'ARM8_be', 'ARM6_be', 'ARM5_be', ]],
      ['Atmel', ['avr32a', 'avr8xmega', 'avr8eind', 'avr8', 'avr8e', ]],
      ['BPF', ['BPF_le', ]],
      ['CP1600', ['CP1600', ]],
      ['CR16', ['CR16C', 'CR16B', ]],
      ['DATA', ['data-be-64', 'data-le-64', ]],
      ['Dalvik', ['Dalvik_DEX_KitKat', 'Dalvik_DEX_Android11', 'Dalvik_DEX_Oreo', 'Dalvik_DEX_Android12', 'Dalvik_DEX_Lollipop', 'Dalvik_DEX_Marshmallow', 'Dalvik_Base', 'Dalvik_DEX_Pie', 'Dalvik_DEX_Android10', 'Dalvik_ODEX_KitKat', 'Dalvik_DEX_Nougat', ]],
      ['HCS08', ['HCS08', 'HC05', 'HC08', ]],
      ['HCS12', ['HCS12', 'HCS12X', 'HC12', ]],
      ['JVM', ['JVM', ]],
      ['Loongarch', ['loongarch64_f32', 'loongarch64_f64', 'loongarch32_f64', 'loongarch32_f32', ]],
      ['M16C', ['M16C_80', 'M16C_60', ]],
      ['M8C', ['m8c', ]],
      ['MC6800', ['6809', 'H6309', '6805', ]],
      ['MCS96', ['MCS96', ]],
      ['MIPS', ['mips32be', 'mips32le', 'mips64le', 'mips64be', 'mips32R6be', 'mips32R6le', ]],
      ['NDS32', ['nds32le', 'nds32be', ]],
      ['PA-RISC', ['pa-risc32be', ]],
      ['PIC', ['dsPIC33C', 'PIC24F', 'dsPIC33F', 'PIC24E', 'pic12c5xx', 'dsPIC33E', 'PIC24H', 'pic16c5x', 'dsPIC30F', 'pic17c7xx', 'pic16', 'pic16f', 'pic18', ]],
      ['PowerPC', ['ppc_32_e500_be', 'ppc_64_isa_altivec_vle_be', 'ppc_64_isa_vle_be', 'ppc_32_4xx_le', 'ppc_32_le', 'ppc_32_be', 'ppc_64_isa_be', 'ppc_32_4xx_be', 'ppc_64_isa_le', 'ppc_64_be', 'ppc_64_le', 'ppc_32_quicciii_be', 'ppc_32_quicciii_le', 'ppc_64_isa_altivec_le', 'ppc_32_e500_le', 'ppc_64_isa_altivec_be', 'ppc_32_e500mc_be', 'ppc_32_e500mc_le', ]],
      ['RISCV', ['riscv.ilp32d', 'riscv.lp64d', 'andestar_v5', ]],
      ['Sparc', ['SparcV9_64', 'SparcV9_32', ]],
      ['SuperH', ['sh-2', 'sh-1', 'sh-2a', ]],
      ['SuperH4', ['SuperH4_le', 'SuperH4_be', ]],
      ['TI_MSP430', ['TI_MSP430X', 'TI_MSP430', ]],
      ['Toy', ['toy_wsz_le', 'toy_builder_be_align2', 'toy_builder_be', 'toy64_be_harvard', 'toy_builder_le_align2', 'toy_builder_le', 'toy64_le', 'toy64_be', 'toy_le', 'toy_be', 'toy_be_posStack', 'toy_wsz_be', 'toy64_be_harvard_rev', ]],
      ['V850', ['V850', ]],
      ['Xtensa', ['xtensa_be', 'xtensa_le', ]],
      ['Z80', ['z80', 'z180', ]],
      ['eBPF', ['eBPF_le', 'eBPF_be', ]],
      ['tricore', ['tricore', ]],
      ['x86', ['x86-64', 'x86', ]],
    ]
    foreach s : p[1]
      sla_spec = join_paths('Ghidra', 'Processors', p[0], 'data',
        'languages', '@0@.slaspec'.format(s))
      sla_files += [ custom_target('@0@_@1@'.format(p[0], s),
        input: sla_spec,
        #output: join_paths(sleigh_base, '@0@.sla'.format(s)),
        output: '@0@.sla'.format(s),
        command: [exec_list['sleighc'], '@INPUT@', '@OUTPUT@'],
        install: true,
        install_dir: join_paths(get_option('libdir'), 'rizin', 'plugins', 'rz_ghidra_sleigh'),
        )]
    endforeach
  endforeach

  # Generated with:
  # for p in $(ls -1 ../subprojects/ghidra/Ghidra/Processors/); do cd "$BUILDDIR/../subprojects/ghidra/Ghidra/Processors/$p"; echo -n "    ['$p', [" ; ^Cr i in $(find -name "*.cspec" -o -name "*.ldefs" -o -name "*.pspec"); do echo -n "'$(basename  $i)', "; done ; echo "]],"  ; done ; cd "$BUILDDIR"
  foreach p :[
    ['6502', ['6502.ldefs', '6502.pspec', '6502.cspec', ]],
    ['68000', ['68000_register.cspec', '68000.cspec', '68000.ldefs', '68000.pspec', ]],
    ['8048', ['8048.ldefs', '8048.pspec', '8048.cspec', ]],
    ['8051', ['8051.cspec', '80390.cspec', '80251.pspec', 'mx51.pspec', '8051_archimedes.cspec', '8051.pspec', 'mx51.cspec', '8051.ldefs', '80251.cspec', ]],
    ['8085', ['8085.pspec', '8085.ldefs', '8085.cspec', ]],
    ['AARCH64', ['AARCH64.ldefs', 'AARCH64.cspec', 'AARCH64_golang.cspec', 'AARCH64.pspec', 'AARCH64_win.cspec', 'AARCH64_apple.cspec', 'AppleSilicon.ldefs', 'AARCH64_ilp32.cspec', 'AARCH64_swift.cspec', ]],
    ['ARM', ['ARM_win.cspec', 'ARM.cspec', 'ARMt_v6.pspec', 'ARMtTHUMB.pspec', 'ARM_v45.pspec', 'ARM_v45.cspec', 'ARMCortex.pspec', 'ARMt.pspec', 'ARM_apcs.cspec', 'ARMt_v45.pspec', 'ARM.ldefs', ]],
    ['Atmel', ['avr32a.pspec', 'avr8.ldefs', 'atmega256.pspec', 'avr8imgCraftV8.cspec', 'avr8egcc.cspec', 'avr8.pspec', 'avr8xmega.pspec', 'avr8iarV1.cspec', 'avr32a.cspec', 'avr32a.ldefs', 'avr8gcc.cspec', ]],
    ['BPF', ['BPF.pspec', 'BPF.cspec', 'BPF.ldefs', ]],
    ['CP1600', ['CP1600.cspec', 'CP1600.pspec', 'CP1600.ldefs', ]],
    ['CR16', ['CR16.cspec', 'CR16.pspec', 'CR16.ldefs', ]],
    ['DATA', ['data-ptr64.cspec', 'data-ptr16.cspec', 'data.ldefs', 'data-ptr32.cspec', 'data.pspec', ]],
    ['Dalvik', ['Dalvik_Base.cspec', 'Dalvik_Base.pspec', 'Dalvik.ldefs', ]],
    ['HCS08', ['HC08.ldefs', 'HC08.pspec', 'HCS08.ldefs', 'HC05.pspec', 'HCS08.cspec', 'HCS08-MC9S08GB60.pspec', 'HCS08.pspec', 'HC08-MC68HC908QY4.pspec', 'HC05.ldefs', 'HC05-M68HC05TB.pspec', 'HC05.cspec', ]],
    ['HCS12', ['HCS12.ldefs', 'HCS12.cspec', 'HCS12.pspec', 'HCS12X.pspec', 'HC12.pspec', 'HCS12X.cspec', 'HC12.cspec', ]],
    ['JVM', ['JVM.pspec', 'JVM.ldefs', 'JVM.cspec', ]],
    ['Loongarch', ['lp64f.cspec', 'lp64d.cspec', 'ilp32d.cspec', 'ilp32f.cspec', 'loongarch64.pspec', 'loongarch32.pspec', 'loongarch.ldefs', ]],
    ['M16C', ['M16C_80.pspec', 'M16C_80.ldefs', 'M16C_60.pspec', 'M16C_60.cspec', 'M16C_60.ldefs', 'M16C_80.cspec', ]],
    ['M8C', ['m8c.pspec', 'm8c.ldefs', 'm8c.cspec', ]],
    ['MC6800', ['6809.cspec', '6809.pspec', '6805.ldefs', '6805.cspec', '6805.pspec', '6800.ldefs', ]],
    ['MCS96', ['MCS96.pspec', 'MCS96.ldefs', 'MCS96.cspec', ]],
    ['MIPS', ['mips.ldefs', 'mips64be.cspec', 'mips64_32_n32.cspec', 'mips32be.cspec', 'mips64R6.pspec', 'mips32_fp64.cspec', 'mips32R6.pspec', 'mips32.pspec', 'mips64le.cspec', 'mips64.pspec', 'mips64_32_o32.cspec', 'mips64micro.pspec', 'mips32le.cspec', 'mips64_32_o64.cspec', 'mips32_eabi.cspec', 'mips32micro.pspec', ]],
    ['NDS32', ['nds32.pspec', 'nds32.ldefs', 'nds32.cspec', ]],
    ['PA-RISC', ['pa-risc.ldefs', 'pa-risc32.cspec', 'pa-risc32.pspec', ]],
    ['PIC', ['pic16.pspec', 'pic16f.pspec', 'PIC24.pspec', 'pic12c5xx.pspec', 'pic12c5xx.ldefs', 'PIC24.cspec', 'pic16f.cspec', 'pic18.cspec', 'pic16c5x.pspec', 'pic16.cspec', 'pic16.ldefs', 'pic17c7xx.cspec', 'pic12c5xx.cspec', 'pic16c5x.ldefs', 'pic17c7xx.ldefs', 'pic18.pspec', 'PIC24.ldefs', 'pic16c5x.cspec', 'pic18.ldefs', 'pic17c7xx.pspec', ]],
    ['PowerPC', ['ppc_32_be_Mac.cspec', 'ppc_32_e500_be.cspec', 'ppc_32_mpc8270.pspec', 'ppc_32_e500mc_le.cspec', 'ppc_32.pspec', 'ppc_64.pspec', 'ppc_64_32.cspec', 'ppc_64_be.cspec', 'ppc_32.cspec', 'ppc_64_le.cspec', 'ppc_32_e500_le.cspec', 'ppc_32_e500mc_be.cspec', 'ppc_64_be_Mac.cspec', 'ppc.ldefs', ]],
    ['RISCV', ['riscv64-fp.cspec', 'riscv32-fp.cspec', 'RV64.pspec', 'RV32.pspec', 'riscv32.cspec', 'riscv.ldefs', 'andestar_v5.ldefs', 'riscv64.cspec', ]],
    ['Sparc', ['SparcV9_32.cspec', 'SparcV9_64.cspec', 'SparcV9.ldefs', 'SparcV9.pspec', ]],
    ['SuperH', ['superh2a.cspec', 'superh.cspec', 'superh.pspec', 'superh.ldefs', ]],
    ['SuperH4', ['SuperH4.pspec', 'SuperH4_le.cspec', 'SuperH4_be.cspec', 'SuperH4.ldefs', ]],
    ['TI_MSP430', ['TI_MSP430.pspec', 'TI_MSP430.cspec', 'TI_MSP430.ldefs', 'TI_MSP430X.cspec', ]],
    ['Toy', ['toy.ldefs', 'toy_harvard.pspec', 'toyPosStack.cspec', 'toy64.cspec', 'toy.pspec', 'toyPosStack.cspec', 'toy64.cspec', 'toy.cspec', 'toy.cspec', 'toy64-long8.cspec', ]],
    ['V850', ['V850.pspec', 'V850.ldefs', 'V850.cspec', ]],
    ['Xtensa', ['xtensa.ldefs', 'xtensa.cspec', 'xtensa.pspec', ]],
    ['Z80', ['z8401x.pspec', 'z180.pspec', 'z182.pspec', 'z80.pspec', 'z8401x.pspec', 'z80.ldefs', 'z80.cspec', ]],
    ['eBPF', ['eBPF.cspec', 'eBPF.pspec', 'eBPF.ldefs', ]],
    ['tricore', ['tc29x.pspec', 'tricore.pspec', 'tricore.ldefs', 'tricore.cspec', 'tc172x.pspec', 'tc176x.pspec', ]],
    ['x86', ['x86delphi.cspec', 'x86-64-win.cspec', 'x86borland.cspec', 'x86-64.pspec', 'x86-64-compat32.pspec', 'x86-16.pspec', 'x86-64-golang.cspec', 'x86-32-golang.cspec', 'x86win.cspec', 'x86-64-gcc.cspec', 'x86-16-real.pspec', 'x86.pspec', 'x86gcc.cspec', 'x86-64-swift.cspec', 'x86.ldefs', 'x86-16.cspec', ]],
    ]
    foreach s : p[1]
      indef = join_paths('Ghidra', 'Processors', p[0], 'data',
        'languages', s)
      sla_files += [ configure_file(
        copy: true,
        input: indef,
        output: s,
        install: true,
        install_dir: join_paths(get_option('libdir'), 'rizin', 'plugins', 'rz_ghidra_sleigh'),
        )]
    endforeach
  endforeach
endif

ghidra_libdecomp_dep = declare_dependency(
  link_with: libs_list['ghidra_libdecomp'],
  include_directories: [source_dir],
  )

